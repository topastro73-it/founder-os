# .env.example — Variabili d'ambiente per founder-os
# Copia in .env e compila con i tuoi valori reali.
# NON committare mai .env

# ─── Fatture in Cloud (MCP server, opzionale) ────────────────────────────────
# Token: https://api-v2.fattureincloud.it/oauth/authorize
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
FIC_SENDER_EMAIL=

# ─── ClickUp (MCP server) ─────────────────────────────────────────────────────
# Crea la key su: https://app.clickup.com/settings/apps
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=
